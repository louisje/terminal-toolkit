{
  "name": "@louisje/terminal-toolkit",
  "version": "0.5.1",
  "description": "A universal terminal toolkit for humans and AI agents",
  "author": "Ellery Familia",
  "repository": {
    "type": "git",
    "url": "https://github.com/louisje/terminal-toolkit.git"
  },
  "bugs": {
    "url": "https://github.com/louisje/terminal-toolkit/issues"
  },
  "homepage": "https://github.com/louisje/terminal-toolkit#readme",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "terminal-toolkit": "bootstrap.cjs"
  },
  "files": [
    "bootstrap.cjs",
    "dist",
    "skills",
    "README.md",
    "LICENSE",
    "logo.png",
    "sandbox-permissions.png",
    "tsconfig.json"
  ],
  "scripts": {
    "build": "tsc --emitDeclarationOnly && node scripts/build.mjs",
    "build:types": "tsc --emitDeclarationOnly",
    "dev": "tsx src/index.ts",
    "prepare": "npm run build",
    "test": "npm run build && node test/run.mjs",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "^0.0.32",
    "@earendil-works/pi-codemode": "^1.3.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@xterm/headless": "^5.3.0",
    "clipboardy": "^5.3.2",
    "node-notifier": "^10.0.1",
    "node-pty": "^1.2.0-beta.15",
    "smol-toml": "^1.6.1",
    "string-width": "^8.2.1",
    "update-notifier": "^7.3.1",
    "yaml": "^2.9.1",
    "zod": "^3.23.0"
  },
  "optionalDependencies": {
    "@resvg/resvg-js": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "@types/node-notifier": "^8.0.5",
    "@types/update-notifier": "^6.0.8",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.0.3",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "mcp",
    "terminal",
    "pty",
    "xterm",
    "ai",
    "claude"
  ],
  "license": "MIT",
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.27.7": true,
    "fsevents@2.3.3": true,
    "node-pty@1.2.0-beta.15": true
  }
}
